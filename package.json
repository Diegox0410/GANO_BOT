{
  "name": "gano-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente inteligente flotante para Gano Sim Premium.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@gano-bot/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@gano-bot/web",
    "preview:web": "npm run preview --workspace=@gano-bot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "npm run clean --workspaces --if-present",
    "clean:install": "npm run clean && node -e \"const fs=require('fs');fs.rmSync('node_modules',{recursive:true,force:true});fs.rmSync('package-lock.json',{force:true})\" && npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knowledge:ingest": "node --env-file=.env.local scripts/ingest-knowledge.mjs"
  },
  "keywords": [
    "gano-bot",
    "gano-sim",
    "chatbot",
    "assistant",
    "react",
    "typescript",
    "firebase",
    "rag"
  ],
  "author": "Gano Sim",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "tldts": "^6.1.86",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "dotenv": "^17.4.2"
  }
}
